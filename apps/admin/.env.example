# admin Next.js app
PORT=4202

# Server-only — used by server actions and route handlers. These never
# reach the browser.
PLATFORM_API_URL=http://localhost:8086
AUTH_BFF_URL=http://localhost:8087

# Browser-exposed (NEXT_PUBLIC_*). Identify the GIP project but do not
# authorize privileged operations. Populated by `make dev-secrets`.
NEXT_PUBLIC_GIP_PROJECT_ID=
NEXT_PUBLIC_GIP_TENANT_ID=
NEXT_PUBLIC_GIP_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:4202
NEXT_PUBLIC_MARKETING_URL=http://localhost:4201
