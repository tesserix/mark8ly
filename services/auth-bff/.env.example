# auth-bff environment variables
ENV=dev
HTTP_PORT=8080
DATABASE_URL=postgres://dev:dev@localhost:5432/auth_bff?sslmode=disable

# GIP / Firebase Auth Emulator
GIP_EMULATOR_HOST=http://localhost:9099
GIP_PROJECT_ID=mark8ly-dev
GIP_TENANTS=platform,mp-internal,mp-customer

# Cookie session
SESSION_COOKIE_NAME=m8_session
SESSION_COOKIE_DOMAIN=.mark8ly.local
SESSION_ENCRYPT_KEY=change-me-32-bytes-minimum-please

# OpenFGA
FGA_API_URL=http://localhost:8089
FGA_STORE_ID=
