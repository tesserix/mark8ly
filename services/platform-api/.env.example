# platform-api environment variables
ENV=dev
HTTP_PORT=8086
DATABASE_URL=postgres://dev:dev@localhost:5432/platform_api?sslmode=disable

# OpenFGA
FGA_API_URL=http://localhost:8089
FGA_STORE_ID=

# Notification (inlined SendGrid for now)
SENDGRID_API_KEY=
EMAIL_FROM=noreply@mark8ly.local

# Storage (inlined GCS for now)
GCS_BUCKET=

# GIP — used by the onboarding "verify-google" path (Phase M) to validate
# a Google-issued GIP id_token via Identity Toolkit accounts:lookup.
# Auto-populated by `make dev-secrets` from infra/dev/.env.local.
GIP_API_KEY=
GIP_TENANT_ID=
