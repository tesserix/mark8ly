# platform-api environment variables
ENV=dev
HTTP_PORT=8086
DATABASE_URL=postgres://dev:dev@localhost:5432/platform_api?sslmode=disable

# OpenFGA
FGA_API_URL=http://localhost:8089
FGA_STORE_ID=

# Notification — EMAIL_PRIMARY_PROVIDER picks who sends first (sendgrid|resend);
# the other provider is the per-message fallback.
SENDGRID_API_KEY=
RESEND_API_KEY=
EMAIL_PRIMARY_PROVIDER=sendgrid
EMAIL_FROM=noreply@mark8ly.local

# Storage (inlined GCS for now)
GCS_BUCKET=

# URL templates used in outbound emails. The %s placeholder is
# substituted with the tenant slug at send time; templates without
# a %s are used as flat hosts (dev). In prod, set these to
# https://%s-admin.mark8ly.com and https://%s.mark8ly.com.
ADMIN_BASE_URL_TEMPLATE=http://localhost:4202
STOREFRONT_BASE_URL_TEMPLATE=http://localhost:4203
