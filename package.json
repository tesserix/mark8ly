{
  "name": "mark8ly",
  "private": true,
  "scripts": {
    "build": "turbo run build --filter='!@mark8ly/platform-api' --filter='!@mark8ly/auth-bff' --filter='!@mark8ly/otto' --filter='!@repo/mobile-storefront' --filter='!@repo/mobile-admin'",
    "dev": "turbo run dev",
    "lint": "turbo run lint --filter='!@mark8ly/platform-api' --filter='!@mark8ly/auth-bff' --filter='!@mark8ly/otto' --filter='!@repo/mobile-storefront' --filter='!@repo/mobile-admin'",
    "test": "npm run audit:dependencies && npm run test:security && turbo run test --filter='!@mark8ly/platform-api' --filter='!@mark8ly/auth-bff' --filter='!@mark8ly/otto' --filter='!@repo/mobile-storefront' --filter='!@repo/mobile-admin'",
    "check-types": "turbo run check-types --filter='!@mark8ly/platform-api' --filter='!@mark8ly/auth-bff' --filter='!@mark8ly/otto' --filter='!@repo/mobile-storefront' --filter='!@repo/mobile-admin'",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check \"package*.json\" \".github/**/*.{yml,yaml,json}\" \"docs/ci.md\"",
    "test:security": "node --test vendor/deepmerge/security.test.cjs vendor/image-size/security.test.cjs scripts/ci/dependency-security.test.cjs",
    "audit:dependencies": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "nanoid": "3.3.18",
    "prettier": "^3.7.4",
    "turbo": "^2.9.4",
    "typescript": "5.9.2",
    "deepmerge": "file:./vendor/deepmerge",
    "image-size": "file:./vendor/image-size",
    "react-native": "0.85.3"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "npm@11.19.0",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "dependencies": {
    "lucide-react": "^1.7.0"
  },
  "overrides": {
    "@xmldom/xmldom": ">=0.9.12 <0.10",
    "tar": ">=7.5.21",
    "@tootallnate/once": ">=3.0.1",
    "esbuild": ">=0.25.0",
    "vite": ">=6.4.2",
    "picomatch": ">=4.0.4",
    "postcss": ">=8.5.23",
    "uuid": ">=14.0.0",
    "fast-uri": ">=3.1.9 <4",
    "websocket-driver": ">=0.7.5",
    "dompurify": ">=3.4.17 <4",
    "protobufjs": ">=7.6.5",
    "shell-quote": ">=1.11.0 <2",
    "brace-expansion@^5.0.5": ">=5.0.12 <6",
    "sharp": ">=0.35.5 <0.36",
    "brace-expansion@^2.0.0": ">=2.1.7 <3",
    "undici@^7.0.0": ">=7.30.1 <8",
    "js-yaml@^3.13.1": ">=3.15.2 <4",
    "js-yaml@^4.1.0": ">=4.3.2 <5",
    "js-yaml@^4.1.1": ">=4.3.2 <5",
    "browserslist": ">=4.28.7",
    "brace-expansion@^1.1.7": ">=1.1.21 <2",
    "source-map-js": ">=1.2.2 <2",
    "undici@^6.0.0": ">=6.29.1 <7",
    "undici@^8.0.0": ">=8.12.2 <9",
    "@grpc/grpc-js": ">=1.13.6 <2",
    "decode-uri-component": "^0.5.1",
    "postcss-selector-parser@^6.0.0": "^6.1.5",
    "glob@>=9 <15": "^14.0.2",
    "minimatch@>=7 <11": "^11.0.1",
    "deepmerge": "$deepmerge",
    "image-size": "$image-size",
    "@expo/cli": {
      "zod": "^4.6.6"
    },
    "re2js": ">=2.8.7 <3"
  }
}
