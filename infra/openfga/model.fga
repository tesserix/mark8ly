model
  schema 1.1

# Phase O — Roles + RBAC.
#
# Four directly-assignable roles on a tenant, ordered roughly by
# authority: owner > admin > staff > viewer. Tuples are written from
# platform-api:
#   - owner is written by the onboarding outbox drainer on Complete()
#   - admin/staff/viewer are reserved for the future invite-teammate
#     flow. Phase O only ships owner writing end-to-end; the other
#     three relations exist so Check() calls against derived permissions
#     work without a second model migration when the invite UI lands.
#
# Derived permissions:
#   - member              — anyone with any role on the tenant. Used by
#                           auth-bff autologin to gate session minting.
#   - can_view_settings   — anyone with any role.
#   - can_edit_settings   — owner or admin. Retrofitted onto Phase N's
#                           PATCH /internal/tenants/:id.
#
# Adding a new permission is purely additive: add a line here, update
# the seed script JSON, deploy. No handler changes needed unless the
# handler consumes the new permission directly.

type user

type tenant
  relations
    # Role hierarchy: owner ⊇ admin ⊇ staff ⊇ viewer.
    # Assigning owner automatically satisfies admin/staff/viewer Check()
    # calls, matching the hierarchy encoded in the Go fake client.
    define owner:  [user]
    define admin:  [user] or owner
    define staff:  [user] or admin
    define viewer: [user] or staff

    define member: viewer

    define can_view_settings:   viewer
    define can_edit_settings:   admin
    define can_invite_members:  admin
    define can_manage_stores:   admin

# Phase Q — store type.
#
# A store lives under a tenant via the `parent` relation. Store-level
# roles (owner/manager/staff/viewer) are reserved for the future
# "invite someone to a specific store" flow in Phase R; Phase Q ships
# them so the model is ready without a second migration.
#
# The `from parent` tuple-to-userset lets tenant-level owners and
# admins automatically inherit store-level permissions without any
# per-store tuple writes — the common case (solo founder with one
# store) needs zero store tuples and Just Works.
type store
  relations
    define parent: [tenant]

    define owner:   [user]
    define manager: [user]
    define staff:   [user]
    define viewer:  [user]

    define tenant_admin: admin from parent
    define tenant_owner: owner from parent

    define member:
        owner or manager or staff or viewer or member from parent
    define can_view_store:
        owner or manager or staff or viewer or member from parent
    define can_edit_store_settings:
        owner or manager or tenant_owner or tenant_admin
    define can_manage_catalog:
        owner or manager or staff or tenant_owner or tenant_admin
